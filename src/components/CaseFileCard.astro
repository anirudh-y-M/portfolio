---
import { href } from '../lib/href';
interface Props {
  id: string; title: string; summary: string; period: string;
  outcome?: { metric: string; before?: string; after?: string };
}
const { id, title, summary, period, outcome } = Astro.props;
const showOutcome = outcome && (outcome.before || outcome.after);
---
<article class="card">
  <p class="mono muted period">{period}</p>
  <h3><a href={href(`/work/${id}`)}>{title}</a></h3>
  <p class="summary">{summary}</p>
  {showOutcome && (
    <p class="outcome mono">
      <span class="muted">{outcome.metric}</span>
      {outcome.before && <span>{outcome.before}</span>}
      {outcome.before && outcome.after && <span class="muted" aria-hidden="true">→</span>}
      {outcome.after && <strong>{outcome.after}</strong>}
      {outcome.before && outcome.after && <span class="visually-hidden">changed from {outcome.before} to {outcome.after}</span>}
    </p>
  )}
</article>

<style>
  .card { padding-block: 1.5rem; border-top: 1px solid var(--rule); }
  .period { margin-bottom: 0.25rem; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  .summary { margin-top: 0.5rem; color: var(--muted); }
  .outcome { margin-top: 0.75rem; display: flex; gap: 0.75ch; flex-wrap: wrap; }
  .outcome strong { color: var(--accent); font-weight: 500; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
