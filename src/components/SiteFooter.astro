---
import { site } from '../data/site';
import { getBuildInfo } from '../lib/build-info';
import { formatDate } from '../lib/dates';
const info = getBuildInfo(process.env);
---
<footer class="footer mono muted">
  <p>
    Text and structure by {site.name}. Set in IBM Plex. Built with Astro to static HTML, no client-side framework.
    Every page ships under 5 KB of JavaScript, and the build fails if one does not.
  </p>
  <p>
    {info.shortSha ? (
      <>
        Deployed from <a href={`${site.repo}/commit/${info.sha}`} rel="noopener">{info.shortSha}</a>
        {' '}on {formatDate(info.builtAt)}
        {info.runUrl && <> · <a href={info.runUrl} rel="noopener">CI run</a></>}
      </>
    ) : (
      <>local build · {formatDate(info.builtAt)}</>
    )}
    {' '}· <a href={site.repo} rel="noopener">Source</a>
  </p>
</footer>

<style>
  .footer { width: 100%; max-width: var(--measure); margin-inline: auto; padding-block: 2rem 3rem; border-top: 1px solid var(--rule); display: grid; gap: 0.5rem; }
</style>
