---
import { href } from '../lib/href';
interface Props { items: { text: string; work: string }[]; titles: Record<string, string> }
const { items, titles } = Astro.props;
---
<ol class="principles">
  {items.map((p) => (
    <li>
      <p>{p.text}</p>
      <p class="mono muted">See: <a href={href(`/work/${p.work}`)}>{titles[p.work] ?? p.work}</a></p>
    </li>
  ))}
</ol>

<style>
  .principles { padding-left: 1.5rem; display: grid; gap: 1.25rem; }
  .principles li::marker { font-family: var(--font-mono); color: var(--muted); }
  .principles li > p:first-child { font-size: var(--step-1); }
</style>
