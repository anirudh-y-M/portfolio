---
interface Props { headline: string; lede: string }
const { headline, lede } = Astro.props;
---
<section class="hero">
  <h1>{headline}</h1>
  <p class="lede">{lede}</p>
  <slot />
</section>

<style>
  .hero { padding-block: clamp(3rem, 10vh, 6rem) 0; }
  .lede { margin-top: 1.25rem; font-size: var(--step-1); color: var(--muted); max-width: 40ch; }
</style>
